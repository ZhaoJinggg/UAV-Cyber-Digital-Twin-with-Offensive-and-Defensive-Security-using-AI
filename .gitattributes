# Keep line endings sane across platforms.
# Shell scripts MUST be LF — a CRLF shebang makes the kernel look for
# "bash\r" and the script fails with: env: bash\r: No such file or directory
*.sh      text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.txt     text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.html    text eol=lf

# Binary assets — never touch these.
*.pdf     binary
*.pt      binary
*.joblib  binary
*.pcap    binary
*.png     binary
*.jpg     binary
